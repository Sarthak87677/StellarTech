# =====================================================================
# StellarTech Explorers Club — environment template
#
# COPY to .env and fill in on the SERVER. Never commit .env to git.
# Never paste real values into a chat, an issue, or a screenshot.
# Every value below is a placeholder name, not a secret.
# =====================================================================

APP_NAME="StellarTech Explorers Club"
APP_ENV=production
APP_KEY=                          # generate with: php artisan key:generate
APP_DEBUG=false                   # MUST stay false in production
APP_URL=https://stellartechexplorers.com
APP_TIMEZONE=Asia/Kolkata

# ---------------------------------------------------------------------
# Database  (Hostinger hPanel -> Databases -> Management)
# Prefix is fixed by Hostinger; append your own suffix.
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1                 # localhost — do NOT use Remote MySQL
DB_PORT=3306
DB_DATABASE=u390930225_YOUR_DB_NAME
DB_USERNAME=u390930225_YOUR_DB_USER
DB_PASSWORD=                      # paste on the server only

# ---------------------------------------------------------------------
# Mail — OTP, approval and contact mail
# Get host/port from hPanel -> Emails -> Configuration.
# The mailbox password goes here and NOWHERE else.
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=director@stellartechexplorers.com
MAIL_PASSWORD=                    # paste on the server only
MAIL_FROM_ADDRESS=director@stellartechexplorers.com
MAIL_FROM_NAME="StellarTech Explorers Club"

# ---------------------------------------------------------------------
# The two club mailboxes
#
# MAIL_SYSTEM_ADDRESS  = connect@  -> SENDS everything to applicants and
#   members: verification, application received, approved/waitlisted/
#   rejected, account activation, password reset, OTP, security alerts,
#   all notifications.
#
# MAIL_FOUNDER_ADDRESS = director@ -> RECEIVES founder alerts only:
#   new application submitted, moderation report, security alert,
#   contact form messages. It never sends member mail.
#
# Leave MAIL_SYSTEM_ADDRESS EMPTY until the connect@ mailbox exists.
# While it is empty everything falls back to director@ and nothing breaks.
# When connect@ is ready, fill it in and also point MAIL_USERNAME,
# MAIL_PASSWORD and MAIL_FROM_ADDRESS at connect@ (see note below).
# ---------------------------------------------------------------------
MAIL_SYSTEM_ADDRESS=
MAIL_FOUNDER_ADDRESS=director@stellartechexplorers.com

# Older name for MAIL_FOUNDER_ADDRESS. Kept so an existing server .env
# keeps working. New installs can leave this blank.
MAIL_CONTACT_TO=director@stellartechexplorers.com

# ---------------------------------------------------------------------
# Sessions & security
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=30               # minutes of idle before logout
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true        # HTTPS only
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

CACHE_STORE=database
QUEUE_CONNECTION=database

# Rakhandar elevation window (seconds)
RAKHANDAR_ELEVATED_TTL=900
OTP_TTL=300

# ---------------------------------------------------------------------
# First founder account — used ONCE by FounderSeeder, then delete both lines
# ---------------------------------------------------------------------
FOUNDER_NAME=
FOUNDER_EMAIL=director@stellartechexplorers.com
FOUNDER_PASSWORD=                 # min 12 chars; REMOVE after seeding

# ---------------------------------------------------------------------
# Space news feed — Spaceflight News API needs NO key.
# Only fill these if you later switch to a paid provider.
# ---------------------------------------------------------------------
NEWS_PROVIDER=snapi
NEWS_CACHE_MINUTES=15
NEWS_API_KEY=                     # leave blank for SNAPI

# ---------------------------------------------------------------------
# Payments — DISABLED. Do not add live keys until official setup is ready.
# ---------------------------------------------------------------------
PAYMENTS_ENABLED=false
RAZORPAY_KEY=
RAZORPAY_SECRET=

# Bump this number after editing any CSS or JS file, so browsers
# fetch the new version instead of a cached one.
ASSET_VERSION=1

LOG_CHANNEL=stack
LOG_LEVEL=error
